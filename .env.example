# ERP Group Khalid Al-Sulaim - Environment Configuration Template
# Production & Local Environment Variables

# Supabase Connection
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Firebase Hybrid Integration (Google Sign-In, Cloud Messaging)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Security & Multi-Factor Authentication
# Set to 'false' ONLY in local mock tests if TOTP is disabled. Defaults to true.
VITE_REQUIRE_MFA=true

# Authentication mode
#   (unset)  → demo directory login in `npm run dev`, REAL Supabase Auth in production builds
#   true     → demo login everywhere (sales demos only — NOT secure, any password works)
#   false    → real Supabase Auth everywhere (use to test real login locally)
VITE_DEMO_AUTH=

# Error Monitoring (Optional)
VITE_SENTRY_DSN=

# Application Info & SEO / QA URLs
VITE_APP_TITLE=ERP Group Khalid Al-Sulaim
VITE_APP_PORT=3001
VITE_PUBLIC_SITE_URL=https://kas-erp.com
PROD_URL=https://kas-erp.com

# Administrative Scripts Only (Do NOT deploy to client bundle)
SUPABASE_SERVICE_ROLE_KEY=
SEED_DEFAULT_PASSWORD=

# Direct HR@kas.sa Official Email Transport (Server-side only — M365 Graph / Office 365 SMTP / Resend)
HR_MAIL_PROVIDER=
HR_MAIL_TENANT_ID=
HR_MAIL_CLIENT_ID=
HR_MAIL_CLIENT_SECRET=
HR_SMTP_HOST=smtp.office365.com
HR_SMTP_PORT=587
HR_SMTP_SECURE=false
HR_SMTP_USER=HR@kas.sa
HR_SMTP_PASS=
RESEND_API_KEY=

# Cloudflare Pro ($25) Pages Edge, Turnstile Anti-Bot & First-Party Supabase Proxy (kas-erp.com)
# Client-side (safe public keys)
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=
VITE_USE_CLOUDFLARE_SUPABASE_PROXY=false
# Server-side Cloudflare Pages Functions ONLY (set in Cloudflare Pages Environment Variables -> Secret)
TURNSTILE_SECRET_KEY=
SUPABASE_UPSTREAM_URL=
