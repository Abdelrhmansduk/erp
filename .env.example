# ERP Group Khalid Al-Sulaim - Environment Configuration Template
# Production & Local Environment Variables

# Supabase Connection
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Security & Multi-Factor Authentication
# Set to 'false' ONLY in local mock tests if TOTP is disabled. Defaults to true.
VITE_REQUIRE_MFA=true

# Authentication mode
#   (unset)  → demo directory login in `npm run dev`, REAL Supabase Auth in production builds
#   true     → demo login everywhere (sales demos only — NOT secure, any password works)
#   false    → real Supabase Auth everywhere (use to test real login locally)
VITE_DEMO_AUTH=

# Error Monitoring (Optional)
VITE_SENTRY_DSN=

# Application Info
VITE_APP_TITLE=ERP Group Khalid Al-Sulaim
VITE_APP_PORT=3001

# Administrative Scripts Only (Do NOT deploy to client bundle)
SUPABASE_SERVICE_ROLE_KEY=
SEED_DEFAULT_PASSWORD=
